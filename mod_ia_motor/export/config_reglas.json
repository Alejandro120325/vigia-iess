  "patrones": {
    "I1": [
      "\\b(?:act[uú]e|actuar|responda|confirme|valide|regularice)\\s+(?:hoy|ahora|de inmediato|inmediatamente)\\b",
      "\\b(?:[uú]ltimo aviso|plazo m[aá]ximo|en las pr[oó]ximas?\\s+\\d+\\s*(?:horas?|minutos?)|antes de hoy)\\b",
      "\\b(?:urgente|con urgencia|acci[oó]n inmediata)\\b"
    ],
    "I2": [
      "https?://[^\\s<>\\\"'()[\\]]+"
    ],
    "I3": [
      "\\b(?:ingrese|env[ií]e|comparta|confirme|actualice|proporcione)\\b.{0,70}\\b(?:contrase[nñ]a|clave|c[oó]digo|token|tarjeta|CVV|PIN)\\b",
