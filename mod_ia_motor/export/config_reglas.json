      "\\b(?:usuario\\s+y\\s+contrase[nñ]a|credenciales)\\b"
    ],
    "I4": [
      "https?://(?:bit\\.ly|cutt\\.ly|cshort\\.jp|tinyurl\\.com|t\\.co|goo\\.gl)/",
      "<a\\b[^>]*href\\s*=\\s*['\\\"][^'\\\"]+['\\\"][^>]*>.*?</a\\s*>"
    ],
    "I5": [
      "\\b[\\w.-]+\\.(?:zip|exe|apk|html?|js|docm|xlsm)\\b",
      "\\b(?:instale|descargue|instalar|descargar)\\b.{0,50}\\b(?:aplicaci[oó]n|app|programa|archivo)\\b",
      "\\b(?:aplicaci[oó]n|app|programa)\\b.{0,50}\\b(?:instale|descargue|instalar|descargar)\\b"
    ],
    "I6": [
      "\\b(?:premio|bono|reembolso|devoluci[oó]n|saldo a su favor|pago en exceso)\\b",
      "\\b(?:ha ganado|gan[oó]|reciba)\\b.{0,40}\\b(?:premio|bono|reembolso|dinero)\\b"
    ],
    "I8": [
      "\\b(?:suspensi[oó]n|suspend(?:er|ida)|bloqueo|bloquear|multa|embargo|p[eé]rdida de beneficios?)\\b",
      "\\b(?:ser[aá] suspendid[oa]|se bloquear[aá]|perder[aá] sus beneficios)\\b"
    ],
    "I9": [
      "\\b(?:env[ií]e|ingrese|proporcione|adjunte|cargue|confirme)\\b.{0,70}\\b(?:c[eé]dula|identificaci[oó]n|fecha de nacimiento|documento|selfie|datos personales)\\b",
      "\\b(?:c[eé]dula|fecha de nacimiento|selfie con documento|datos personales)\\b"
    ],
    "I10": [
      "\\b(?:transfiera|deposite|pague|realice el pago|efect[uú]e el pago|env[ií]e dinero)\\b",
      "\\b(?:dep[oó]sito|transferencia|tasa de activaci[oó]n|multa|criptomonedas?|bitcoin)\\b"
    ],
    "I7": [
      "[\\w.+-]+@[\\w.-]+\\.[a-z]{2,}",
      "\\bReply-To\\b"
    ],
    "I11": [
      "\\b(?:c[oó]digo|escanee|escanear)\\s+QR\\b",
      "\\bQR\\b"
    ]
  },
